RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:CF-Visitor} !{"scheme":"https"}
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect parents portal to show a popup and redirect to the new portal
RewriteCond %{REQUEST_URI} !^/parents-redirect\.html$
RewriteRule ^/?parents(\.php|\.html|/?)$ /parents-redirect.html [L,NC]

# Custom Error Pages
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Block direct access to events.json so outsiders cannot view it
<Files "events.json">
    Require all denied
</Files>